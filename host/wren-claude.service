# Answers Wren's ad-read requests with `claude -p` (see wren-claude-helper).
# Install as a systemd user unit; set WREN_DATA_DIR in both this file and
# wren-claude.path to the host folder mounted at /data in the Wren container.
[Unit]
Description=Answer Wren's ad-read requests with Claude Code

[Service]
Type=oneshot
Environment=WREN_DATA_DIR=/path/to/wren-data
# Optional: a long-lived token from `claude setup-token`, on the first line of
# a file only you can read, instead of the interactive login.
#Environment=CLAUDE_TOKEN_FILE=%h/.config/wren-claude/token
# Where the Claude Code installer puts `claude`.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Rootless podman: the data folder belongs to the container's user, so run as
# the container's root (`podman unshare`), which may write there. Without
# rootless podman, run the helper directly.
ExecStart=/usr/bin/podman unshare %h/.local/bin/wren-claude-helper ${WREN_DATA_DIR}
Nice=10
TimeoutStartSec=2h
